          "fieldToSplitOut": "news_title"
        },
        "typeVersion": 1
      },
      {
        "name": "Merge",
        "type": "n8n-nodes-base.merge",
        "position": [
          700,
          470
        ],
        "parameters": {
          "mode": "mergeByIndex"
        },
        "typeVersion": 1
      },
      {
        "name": "Spreadsheet File",
        "type": "n8n-nodes-base.spreadsheetFile",
        "position": [
